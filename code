<!DOCTYPE html>
<html lang="ja" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>九大フィル・カンマーオーケストラ</title>
    <!-- Tailwind CSS for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Noto Serif JP for a classy, orchestral feel -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;700&display=swap" rel="stylesheet">
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* Custom styles for specific elements not easily handled by Tailwind alone */
        body {
            font-family: 'Noto Serif JP', serif;
            color: #333;
            background-color: #fcfcfc;
        }
        
        .hero-section {
            background-color: #1e293b;
            /* background-image: linear-gradient(rgba(15, 23, 42, 0.7), rgba(15, 23, 42, 0.7)), url('kammer_profile.jpg'); */
            background-position: center;
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        .section-title::after {
            content: '';
            display: block;
            width: 60px;
            height: 2px;
            background-color: #1e3a8a; /* Tailwind blue-900 */
            margin: 1rem auto 0;
        }
    </style>
</head>
<body class="antialiased">

    <!-- Navigation -->
    <nav class="fixed w-full z-50 transition-all duration-300" id="navbar">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Logo/Title -->
                <div class="flex-shrink-0">
                    <a href="#" class="text-xl md:text-2xl font-bold tracking-wider text-white" id="nav-brand">
                        Kyudai Philharmonic Kammerorchester
                    </a>
                </div>
                
                <!-- Desktop Menu -->
                <div class="hidden md:flex space-x-8">
                    <a href="#about" class="text-white hover:text-blue-300 transition duration-300 nav-link">About</a>
                    <a href="#activities" class="text-white hover:text-blue-300 transition duration-300 nav-link">Activities</a>
                    <a href="#history" class="text-white hover:text-blue-300 transition duration-300 nav-link">History</a>
                    <a href="#contact" class="text-white hover:text-blue-300 transition duration-300 nav-link">Contact</a>
                </div>

                <!-- Mobile Menu Button -->
                <div class="md:hidden flex items-center">
                    <button id="mobile-menu-btn" class="text-white hover:text-gray-300 focus:outline-none">
                        <i class="fas fa-bars text-2xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu (Hidden by default) -->
        <div id="mobile-menu" class="hidden md:hidden bg-white shadow-lg absolute w-full">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
                <a href="#about" class="block px-3 py-2 text-gray-800 hover:bg-gray-100 mobile-nav-link">About</a>
                <a href="#activities" class="block px-3 py-2 text-gray-800 hover:bg-gray-100 mobile-nav-link">Activities</a>
                <a href="#history" class="block px-3 py-2 text-gray-800 hover:bg-gray-100 mobile-nav-link">History</a>
                <a href="#contact" class="block px-3 py-2 text-gray-800 hover:bg-gray-100 mobile-nav-link">Contact</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="hero-section h-screen flex flex-col justify-center items-center text-center px-4 relative">
        <div class="z-10 animate-fade-in-up">
            <h1 class="text-4xl md:text-6xl font-bold text-white mb-4 tracking-widest drop-shadow-lg">
                九大フィル<br class="md:hidden">・カンマーオーケストラ
            </h1>
            <p class="text-lg md:text-2xl text-gray-200 mb-8 font-light tracking-wide">
                Kyushu University Philharmonic Kammerorchestra
            </p>
            <a href="#about" class="inline-block border-2 border-white text-white px-8 py-3 rounded-full hover:bg-white hover:text-gray-900 transition duration-300">
                詳細を見る <i class="fas fa-chevron-down ml-2"></i>
            </a>
        </div>
        
        <!-- Scroll indicator -->
        <div class="absolute bottom-10 animate-bounce">
            <a href="#about" class="text-white opacity-70 hover:opacity-100 transition">
                <i class="fas fa-angle-double-down text-3xl"></i>
            </a>
        </div>
    </header>

    <!-- About Section -->
    <section id="about" class="py-20 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold text-center mb-12 section-title text-gray-800 tracking-wider">団体概要</h2>
            <div class="prose prose-lg mx-auto text-gray-600 leading-relaxed text-justify">
                <p class="mb-6">
                    九大フィル・カンマーオーケストラは、九大フィル・ハーモニーオーケストラを母体とし、同楽団のメンバーによって構成されているる室内管弦楽団です。
                </p>
                <p class="mb-6">
                   大編成のオーケストラでは取り上げにくい古典派の楽曲を中心に演奏することを目的として設立されました。
                </p>
                <p>
                   九州大学OBの井上京氏を指揮者として迎え、小規模編成ならではの緻密なアンサンブルを追求しています。
                </p>
            </div>
        </div>
    </section>

    <!-- Activities Section -->
    <section id="activities" class="py-20 bg-gray-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold text-center mb-16 section-title text-gray-800 tracking-wider">活動内容</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                <!-- Activity 1 -->
                <div class="bg-white p-8 rounded-lg shadow-sm border border-gray-100 hover:shadow-md transition duration-300">
                    <div class="text-blue-900 text-4xl mb-4"><i class="fas fa-music"></i></div>
                    <h3 class="text-xl font-bold mb-4 text-gray-800">定期演奏会</h3>
                    <p class="text-gray-600">
                       年に１回、福岡市内のホールにて定期演奏会を開催しています。
                    </p>
                </div>
                
                <!-- Activity 2 -->
                <div class="bg-white p-8 rounded-lg shadow-sm border border-gray-100 hover:shadow-md transition duration-300">
                    <div class="text-blue-900 text-4xl mb-4"><i class="fas fa-users"></i></div>
                    <h3 class="text-xl font-bold mb-4 text-gray-800">練習について</h3>
                    <p class="text-gray-600">
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Present / Up-coming Concerts Section -->
    <section id="Present" class="py-20 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold text-center mb-12 section-title text-gray-800 tracking-wider">これからの演奏会</h2>

                <!-- Concert Item (Dummy Data) -->
                <div class="border-l-4 border-gray-300 pl-6 py-2">
                    <h3 class="text-lg font-bold text-gray-800">第２回 演奏会</h3>
                    <p class="text-sm text-gray-500 mb-2">2026年 9月10日（木） | [なみきホール]</p>
                    <ul class="text-gray-600 list-disc list-inside">
                        <li>ドヴォルザーク / ヴァイオリン協奏曲</li>
                        <li>ベートーヴェン / 交響曲第5番（運命）</li>
                    </ul>
                </div>
</section>

    <!-- History / Past Concerts Section -->
    <section id="history" class="py-20 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold text-center mb-12 section-title text-gray-800 tracking-wider">過去の演奏会</h2>
            
            <div class="space-y-8">
                <!-- Concert Item (Dummy Data) -->
                <div class="border-l-4 border-blue-900 pl-6 py-2">
                    <h3 class="text-lg font-bold text-gray-800">第１回 演奏会</h3>
                    <p class="text-sm text-gray-500 mb-2">2025年 9月17日 | [FFGホール]</p>
                    <ul class="text-gray-600 list-disc list-inside">
                        <li>モーツァルト / ヴァイオリン協奏曲第５番</li>
                        <li>モーツァルト / 交響曲第35番《ハフナー》 ほか</li>
                    </ul>
                </div>
                
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-20 bg-gray-900 text-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-3xl font-bold mb-8 tracking-wider">お問い合わせ</h2>
            <p class="mb-8 text-gray-300 max-w-2xl mx-auto">
                当団に関するご質問、演奏のご依頼などは、下記よりお問い合わせください。<br>
                <span class="text-sm">※お問い合わせへの返信にはお時間をいただく場合がございます。</span>
            </p>
            
            <!-- 
              Note: For a low-maintenance site, a simple mailto link or a link to a Google Form 
              is often better than a complex PHP contact form.
            -->
            <div class="flex justify-center space-x-6">
                <!-- Email Link -->
                <a href="mailto:example@example.com" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-md transition duration-300 flex items-center">
                    <i class="fas fa-envelope mr-2"></i> メールを送る
                </a>
                
                <!-- Optional: Social Media Links (if any) -->
                <!--
                <a href="#" class="text-gray-400 hover:text-white text-3xl transition duration-300">
                    <i class="fab fa-twitter"></i>
                </a>
                -->
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-black text-gray-400 py-8 text-center text-sm">
        <div class="max-w-7xl mx-auto px-4">
            <p>&copy; <span id="current-year"></span> 九大フィル・カンマーオーケストラ (Kyudai Philharmonic Kammerorchester). All rights reserved.</p>
        </div>
    </footer>

    <!-- JavaScript for Interactions -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Set current year in footer
            document.getElementById('current-year').textContent = new Date().getFullYear();

            // Navbar scroll effect
            const navbar = document.getElementById('navbar');
            const navBrand = document.getElementById('nav-brand');
            const navLinks = document.querySelectorAll('.nav-link');
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenuIcon = mobileMenuBtn.querySelector('i');

            window.addEventListener('scroll', () => {
                if (window.scrollY > 50) {
                    navbar.classList.add('bg-white', 'shadow-md');
                    navbar.classList.remove('bg-transparent');
                    navBrand.classList.add('text-gray-900');
                    navBrand.classList.remove('text-white');
                    mobileMenuIcon.classList.add('text-gray-900');
                    mobileMenuIcon.classList.remove('text-white');
                    navLinks.forEach(link => {
                        link.classList.add('text-gray-700', 'hover:text-blue-600');
                        link.classList.remove('text-white', 'hover:text-blue-300');
                    });
                } else {
                    navbar.classList.remove('bg-white', 'shadow-md');
                    navbar.classList.add('bg-transparent');
                    navBrand.classList.remove('text-gray-900');
                    navBrand.classList.add('text-white');
                    mobileMenuIcon.classList.remove('text-gray-900');
                    mobileMenuIcon.classList.add('text-white');
                    navLinks.forEach(link => {
                        link.classList.remove('text-gray-700', 'hover:text-blue-600');
                        link.classList.add('text-white', 'hover:text-blue-300');
                    });
                }
            });

            // Mobile menu toggle
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

            mobileMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            // Close mobile menu when a link is clicked
            mobileNavLinks.forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                });
            });
        });
    </script>
</body>
</html>
